# GEMINI_API_KEY: Required for Gemini AI API calls.
# Get your key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY="YOUR_GEMINI_API_KEY_HERE"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3001"

# Cloud SQL Credentials (runtime - regular DB user)
SQL_HOST=localhost
SQL_DB_NAME=property_manager
SQL_USER=postgres
SQL_PASSWORD=postgres

# Cloud SQL Admin Credentials (for drizzle migrations only)
SQL_ADMIN_USER=postgres
SQL_ADMIN_PASSWORD=postgres

# JWT Secret for Custom Auth Session Signing (min 32 chars, use a strong random value)
JWT_SECRET=your-super-secret-jwt-key-change-me-in-production

# Port for the API server (Railway sets this automatically)
PORT=3001

# CORS: allow the Vercel frontend URL in production
# For local dev, set to http://localhost:5173
CORS_ORIGIN=http://localhost:5173
