# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY_HERE"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3001"

# --- Option A: Single connection string (preferred - use with Neon) ---
# DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# --- Option B: Individual credentials ---
# SQL_HOST=localhost
# SQL_DB_NAME=property_manager
# SQL_USER=postgres
# SQL_PASSWORD=postgres
# SQL_ADMIN_USER=postgres
# SQL_ADMIN_PASSWORD=postgres

# JWT Secret for Custom Auth Session Signing (min 32 chars)
JWT_SECRET=replace-with-a-random-32-char-string

# Port for the API server
PORT=3001

# CORS: allow the Vercel frontend URL in production
# For local dev: http://localhost:5173
CORS_ORIGIN=http://localhost:5173
